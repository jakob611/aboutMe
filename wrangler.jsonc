{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aboutme",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aboutme"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "aboutme-uploads"
    }
  ],
  "ratelimits": [
    { "name": "ADMIN_LOGIN_LIMITER", "namespace_id": "710611", "simple": { "limit": 5, "period": 60 } }
  ],
  "keep_vars": true
}
