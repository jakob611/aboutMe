# Copy to .dev.vars for local Cloudflare preview, or .env.local for next dev.
# Never commit real credentials. Prefer a Neon development branch for local work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
UPLOAD_PASSWORD=replace-with-your-existing-upload-password
# Optional fallback when UPLOAD_PASSWORD is absent. Normally leave this empty.
ADMIN_PASSWORD=
# Replace this placeholder with an independently generated random secret (32+ characters).
ADMIN_SESSION_SECRET=
# Independent stable runtime key (32+ random characters) for private moderation
# encryption and address identifiers. Keep it across deploys. Rotating it needs
# a metadata/block-list migration; do not reuse the admin session signing key.
MODERATION_SECRET=
SITE_OWNER=Jakob Tominc
SITE_TAGLINE=Android, web and hands-on projects
CONTACT_EMAIL=replace-with-your-email
NEXT_PUBLIC_SITE_URL=https://jakobtominc.com
# Contact and project comments use server-verified Turnstile. Contact goes to the
# private Neon inbox, without email.
# This site key is public. Set it in .env.local or Cloudflare Build variables before
# building; a runtime value alone does not replace an existing browser bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Runtime secret: keep out of all NEXT_PUBLIC_ settings and committed files.
TURNSTILE_SECRET=
# Exact request hostnames, not URLs. LOCAL ONLY: production must omit localhost
# and use only its intended frontend domains, also allowed in the widget settings.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
