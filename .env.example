# Copy to .dev.vars for local Cloudflare preview, or .env.local for next dev.
# Never commit real credentials. Prefer a Neon development branch for local work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
UPLOAD_PASSWORD=replace-with-your-existing-upload-password
# Optional fallback when UPLOAD_PASSWORD is absent. Normally leave this empty.
ADMIN_PASSWORD=
# Replace this placeholder with an independently generated random secret (32+ characters).
ADMIN_SESSION_SECRET=
SITE_OWNER=Jakob Tominc
SITE_TAGLINE=Android, web and hands-on projects
CONTACT_EMAIL=replace-with-your-email
NEXT_PUBLIC_SITE_URL=https://jakobtominc.com
# Optional: owner's Web3Forms public access key. Leave empty to use the Neon inbox.
# This key is public, not a secret. Free-plan submissions go browser-direct to Web3Forms.
# NEXT_PUBLIC values are embedded at build time: set this in .env.local for local builds,
# or in the Cloudflare Build variables for the intended preview/production environment,
# then rebuild. A .dev.vars runtime value alone does not update an existing browser bundle.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
